{
  "name": "hd2d-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A three.js engine for HD-2D style games: pixel art sprites in a lit, depth-of-field 3D world.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "7.3.7"
  }
}
